filters:
  and:
    - file.name != "🏠 Index.base"
views:
  - type: table
    name: Table
    order:
      - file.name
      - Spell Type
      - Year Learned
      - Summary
    sort:
      - property: Year Learned
        direction: ASC
      - property: Summary
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      note.Year Learned: 68
